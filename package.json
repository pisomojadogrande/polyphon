{
  "name": "polyphon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild web/app.ts --bundle --format=esm --outfile=dist/app.js",
    "start": "tsx src/server.ts",
    "dev": "npm run build && npm start",
    "cli": "tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:python": ".venv/bin/python -m unittest discover -s python -p 'test_*.py'",
    "fixture": "python3 python/make_fixture.py",
    "check": "npm run build && npm test",
    "evaluate": "tsx src/evaluate.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tonejs/midi": "2.0.28",
    "vexflow": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
